<div class="mx-auto max-w-md p-4">
  <h1 class="text-2xl font-bold text-[var(--tui-accent)] tracking-widest">
    TUIs everywhere — the lobby
  </h1>
  <p :if={@error} id="join-error" class="text-red-400 py-2">{@error}</p>
  <form id="join-form" action={~p"/join"} method="post" class="flex flex-col gap-3 pt-2">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
    <div>
      <label for="nickname" class="block text-sm text-[var(--tui-dim)]">Nickname</label>
      <div class="flex items-center gap-2 border border-[var(--tui-border)] px-2 py-1">
        <span class="text-[var(--tui-accent)]">&gt;</span>
        <input
          id="nickname"
          name="nickname"
          type="text"
          minlength="2"
          maxlength="16"
          required
          class="flex-1 border-0 bg-transparent text-[var(--tui-fg)] outline-none caret-[var(--tui-accent)]"
        />
      </div>
    </div>
    <fieldset id="avatar-grid" class="border border-[var(--tui-border)] p-2">
      <legend class="text-sm px-1 text-[var(--tui-dim)]">Pick an avatar</legend>
      <label :for={avatar <- @avatars} class="group inline-block m-1 cursor-pointer">
        <input type="radio" name="avatar_id" value={avatar.id} required class="peer sr-only" />
        <div class="p-1 border border-[var(--tui-border)] peer-checked:border-[var(--tui-accent)] peer-checked:bg-[var(--tui-accent-tint)]">
          <.sprite cells={avatar.sprite_cells} />
          <span class="block text-xs text-center text-[var(--tui-dim)] peer-checked:text-[var(--tui-accent)]">
            {avatar.name}
          </span>
        </div>
      </label>
    </fieldset>
    <button
      type="submit"
      class="border border-[var(--tui-border)] px-3 py-2 self-start text-[var(--tui-fg)] hover:border-[var(--tui-accent)] hover:text-[var(--tui-accent)]"
    >
      Enter the lobby
    </button>
  </form>
  <footer
    id="data-notice"
    class="text-xs text-[var(--tui-dim)] border-t border-[var(--tui-border)] pt-6"
  >
    Everything here lives in memory (ETS via Ash). You disappear when you disconnect.
    Messages are wiped when the server restarts. Please don't post personal information.
    <a
      href="https://github.com/mcass19/cbe_2026/blob/main/lobby_tui/docs/PRIVACY.md"
      class="underline"
    >
      Privacy note
    </a>
  </footer>
</div>
