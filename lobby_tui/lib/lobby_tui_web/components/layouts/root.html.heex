<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default={shared_title()}>
      {assigns[:page_title]}
    </.live_title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%2316141a'/%3E%3Crect x='1' y='1' width='30' height='3' fill='%233e112a'/%3E%3Crect x='1' y='4' width='30' height='1' fill='%23eeb460'/%3E%3Crect x='1' y='5' width='9' height='20' fill='%236c2848'/%3E%3Crect x='22' y='5' width='9' height='20' fill='%236c2848'/%3E%3Crect x='3' y='5' width='2' height='20' fill='%234e1c34'/%3E%3Crect x='6' y='5' width='2' height='20' fill='%238c345e'/%3E%3Crect x='24' y='5' width='2' height='20' fill='%238c345e'/%3E%3Crect x='27' y='5' width='2' height='20' fill='%234e1c34'/%3E%3Crect x='10' y='5' width='12' height='20' fill='%23f5d576' opacity='0.16'/%3E%3Crect x='1' y='25' width='30' height='2' fill='%23eeb460'/%3E%3Crect x='1' y='27' width='30' height='2' fill='%23a07440'/%3E%3Crect x='1' y='29' width='30' height='2' fill='%23785430'/%3E%3C/svg%3E"
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
